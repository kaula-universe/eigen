import std.math
import std.memory
import "C:/Code/algebra/algebra"
import std.algebra

class Matrix {
    rows: int
    cols: int
    data: Expr*

    constructor(int r, int c) {
        self.rows = r
        self.cols = c
        self.data = std.memory.std_malloc(r * c * sizeof(Expr))
        int n = r * c
        int i = 0
        while (i < n) {
            self.data[i] = expr_rat(0, 1)
            i = i + 1
        }
    }

    fn rows() int {
        return self.rows
    }

    fn cols() int {
        return self.cols
    }

    fn set(int i, int j, Expr v) {
        self.data[i * self.cols + j] = v
    }

    fn get(int i, int j) Expr {
        return self.data[i * self.cols + j]
    }

    fn fill(Expr v) {
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                self.set(i, j, v)
                j = j + 1
            }
            i = i + 1
        }
    }

    fn copy() Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                r.set(i, j, self.get(i, j))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn add(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Expr a = self.get(i, j)
                Expr b = other.get(i, j)
                r.set(i, j, simplify(expr_add(a, b)))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn sub(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Expr a = self.get(i, j)
                Expr b = other.get(i, j)
                r.set(i, j, simplify(expr_sub(a, b)))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn mul(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, other.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < other.cols) {
                Expr acc = expr_rat(0, 1)
                int k = 0
                while (k < self.cols) {
                    Expr ma = self.get(i, k)
                    Expr mb = other.get(k, j)
                    Expr p = simplify(expr_mul(ma, mb))
                    acc = simplify(expr_add(acc, p))
                    k = k + 1
                }
                r.set(i, j, acc)
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn scalar_mul(Expr s) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Expr a = self.get(i, j)
                r.set(i, j, simplify(expr_mul(a, s)))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn transpose() Matrix {
        Matrix r = Matrix(self.cols, self.rows)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                r.set(j, i, self.get(i, j))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn trace() Expr {
        Expr acc = expr_rat(0, 1)
        int i = 0
        while (i < self.rows) {
            Expr tv = self.get(i, i)
            acc = simplify(expr_add(acc, tv))
            i = i + 1
        }
        return acc
    }

    fn cwise_mul(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Expr a = self.get(i, j)
                Expr b = other.get(i, j)
                r.set(i, j, simplify(expr_mul(a, b)))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }

    fn swap_rows(int a, int b) {
        int j = 0
        while (j < self.cols) {
            Expr t = self.get(a, j)
            self.set(a, j, self.get(b, j))
            self.set(b, j, t)
            j = j + 1
        }
    }

    # 符号行列式: 高斯消元(符号除法, 精确表达式)
    fn determinant() Expr {
        Matrix w = self.copy()
        Expr det = expr_rat(1, 1)
        int i = 0
        while (i < w.rows) {
            Expr p = w.get(i, i)
            if (p.kind == 0 && std.algebra.bigint_to_i64(&p.num) == 0) {
                # 常数零主元: 找下方非零行交换(换行变号)
                int piv = -1
                int k = i + 1
                while (k < w.rows) {
                    Expr q = w.get(k, i)
                    if (q.kind != 0 || std.algebra.bigint_to_i64(&q.num) != 0) {
                        piv = k
                    }
                    k = k + 1
                }
                if (piv < 0) {
                    return expr_rat(0, 1)
                }
                w.swap_rows(piv, i)
                det = simplify(expr_mul(det, expr_rat(-1, 1)))
                p = w.get(i, i)
            }
            det = simplify(expr_mul(det, p))
            int r = i + 1
            while (r < w.rows) {
                Expr pv = w.get(r, i)
                Expr f = simplify(expr_div(pv, p))
                int c = i
                while (c < w.cols) {
                    Expr c1 = w.get(r, c)
                    Expr c2 = simplify(expr_mul(f, w.get(i, c)))
                    Expr nv = simplify(expr_sub(c1, c2))
                    w.set(r, c, nv)
                    c = c + 1
                }
                r = r + 1
            }
            i = i + 1
        }
        return det
    }

    # 符号逆矩阵: 增广矩阵高斯消元(精确表达式)
    fn inverse() Matrix {
        int n = self.rows
        Matrix aug = Matrix(n, 2 * n)
        int i = 0
        while (i < n) {
            int j = 0
            while (j < n) {
                aug.set(i, j, self.get(i, j))
                j = j + 1
            }
            int j2 = 0
            while (j2 < n) {
                if (i == j2) {
                    aug.set(i, n + j2, expr_rat(1, 1))
                } else {
                    aug.set(i, n + j2, expr_rat(0, 1))
                }
                j2 = j2 + 1
            }
            i = i + 1
        }
        int i2 = 0
        while (i2 < n) {
            Expr p = aug.get(i2, i2)
            if (p.kind == 0 && std.algebra.bigint_to_i64(&p.num) == 0) {
                return Matrix(0, 0)
            }
            int j3 = 0
            while (j3 < 2 * n) {
                Expr av = aug.get(i2, j3)
                aug.set(i2, j3, simplify(expr_div(av, p)))
                j3 = j3 + 1
            }
            int r = 0
            while (r < n) {
                if (r != i2) {
                    Expr f = aug.get(r, i2)
                    int c2 = 0
                    while (c2 < 2 * n) {
                        Expr c1 = aug.get(r, c2)
                        Expr c2v = simplify(expr_mul(f, aug.get(i2, c2)))
                        Expr nv = simplify(expr_sub(c1, c2v))
                        aug.set(r, c2, nv)
                        c2 = c2 + 1
                    }
                }
                r = r + 1
            }
            i2 = i2 + 1
        }
        Matrix inv = Matrix(n, n)
        int i3 = 0
        while (i3 < n) {
            int j4 = 0
            while (j4 < n) {
                inv.set(i3, j4, aug.get(i3, n + j4))
                j4 = j4 + 1
            }
            i3 = i3 + 1
        }
        return inv
    }

    # 符号解线性方程组 Ax = b(高斯消元, 精确表达式)
    fn solve(Matrix b) Matrix {
        int n = self.rows
        Matrix aug = Matrix(n, n + 1)
        int i = 0
        while (i < n) {
            int j = 0
            while (j < n) {
                aug.set(i, j, self.get(i, j))
                j = j + 1
            }
            aug.set(i, n, b.get(i, 0))
            i = i + 1
        }
        int i2 = 0
        while (i2 < n) {
            Expr p = aug.get(i2, i2)
            if (p.kind == 0 && std.algebra.bigint_to_i64(&p.num) == 0) {
                return Matrix(0, 0)
            }
            int j3 = 0
            while (j3 < n + 1) {
                Expr av = aug.get(i2, j3)
                aug.set(i2, j3, simplify(expr_div(av, p)))
                j3 = j3 + 1
            }
            int r = 0
            while (r < n) {
                if (r != i2) {
                    Expr f = aug.get(r, i2)
                    int c2 = 0
                    while (c2 < n + 1) {
                        Expr c1 = aug.get(r, c2)
                        Expr c2v = simplify(expr_mul(f, aug.get(i2, c2)))
                        Expr nv = simplify(expr_sub(c1, c2v))
                        aug.set(r, c2, nv)
                        c2 = c2 + 1
                    }
                }
                r = r + 1
            }
            i2 = i2 + 1
        }
        Matrix x = Matrix(n, 1)
        int i3 = 0
        while (i3 < n) {
            x.set(i3, 0, aug.get(i3, n))
            i3 = i3 + 1
        }
        return x
    }

    fn print() {
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Expr pv = self.get(i, j)
                display(pv)
                j = j + 1
            }
            i = i + 1
        }
    }
}

# 工厂: 符号矩阵
fn matrix_zeros(r: int, c: int) Matrix {
    return Matrix(r, c)
}

fn matrix_ones(r: int, c: int) Matrix {
    Matrix m = Matrix(r, c)
    int i = 0
    while (i < r) {
        int j = 0
        while (j < c) {
            m.set(i, j, expr_rat(1, 1))
            j = j + 1
        }
        i = i + 1
    }
    return m
}

fn matrix_eye(n: int) Matrix {
    Matrix m = Matrix(n, n)
    int i = 0
    while (i < n) {
        m.set(i, i, expr_rat(1, 1))
        i = i + 1
    }
    return m
}

fn matrix_diag(v: Matrix) Matrix {
    int n = v.rows()
    Matrix m = Matrix(n, n)
    int i = 0
    while (i < n) {
        m.set(i, i, v.get(i, 0))
        i = i + 1
    }
    return m
}

class SparseMatrix {
    rows: int
    cols: int
    def: f64
    nnz: int
    cap: int
    values: f64*
    rindices: int*
    cindices: int*
    fn nnz_count() int {
        return self.nnz
    }
    fn grow() {
        int newcap = 16
        if (self.cap > 0) {
            newcap = self.cap * 2
        }
        self.values = std.memory.kmm_v4_realloc(self.values, newcap * 8)
        self.rindices = std.memory.kmm_v4_realloc(self.rindices, newcap * 4)
        self.cindices = std.memory.kmm_v4_realloc(self.cindices, newcap * 4)
        self.cap = newcap
    }
    fn find(int i, int j) int {
        int k = 0
        while (k < self.nnz) {
            if (self.rindices[k] == i) {
                if (self.cindices[k] == j) {
                    return k
                }
            }
            k = k + 1
        }
        return -1
    }
    fn set(int i, int j, f64 v) {
        if (i < 0) {
            return
        }
        if (i >= self.rows) {
            return
        }
        if (j < 0) {
            return
        }
        if (j >= self.cols) {
            return
        }
        int k = self.find(i, j)
        if (k >= 0) {
            f64 diff = v - self.def
            if (diff == 0.0) {
                while (k < self.nnz - 1) {
                    self.values[k] = self.values[k + 1]
                    self.rindices[k] = self.rindices[k + 1]
                    self.cindices[k] = self.cindices[k + 1]
                    k = k + 1
                }
                self.nnz = self.nnz - 1
            } else {
                self.values[k] = v
            }
            return
        }
        f64 d2 = v - self.def
        if (d2 == 0.0) {
            return
        }
        if (self.nnz >= self.cap) {
            self.grow()
        }
        int pos = self.nnz
        while (pos > 0) {
            int pr = self.rindices[pos - 1]
            int pc = self.cindices[pos - 1]
            if (pr < i) {
                break
            }
            if (pr == i) {
                if (pc < j) {
                    break
                }
            }
            self.values[pos] = self.values[pos - 1]
            self.rindices[pos] = self.rindices[pos - 1]
            self.cindices[pos] = self.cindices[pos - 1]
            pos = pos - 1
        }
        self.values[pos] = v
        self.rindices[pos] = i
        self.cindices[pos] = j
        self.nnz = self.nnz + 1
    }
    fn get(int i, int j) f64 {
        int k = self.find(i, j)
        if (k >= 0) {
            return self.values[k]
        }
        return self.def
    }
    fn to_dense() Matrix {
        Matrix m = Matrix(self.rows, self.cols)
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            int iv = self.def
            m.data[i] = expr_rat(iv, 1)
            i = i + 1
        }
        int a = 0
        while (a < self.nnz) {
            int iv = self.values[a]
            m.set(self.rindices[a], self.cindices[a], expr_rat(iv, 1))
            a = a + 1
        }
        return m
    }
    fn add(SparseMatrix other) SparseMatrix {
        SparseMatrix r = SparseMatrix(self.rows, self.cols, self.def + other.def)
        int a = 0
        while (a < self.nnz) {
            f64 v = self.values[a] + other.get(self.rindices[a], self.cindices[a])
            r.set(self.rindices[a], self.cindices[a], v)
            a = a + 1
        }
        int b = 0
        while (b < other.nnz) {
            f64 v = other.values[b] + self.get(other.rindices[b], other.cindices[b])
            r.set(other.rindices[b], other.cindices[b], v)
            b = b + 1
        }
        return r
    }
    fn scalar_mul(f64 v) SparseMatrix {
        SparseMatrix r = SparseMatrix(self.rows, self.cols, self.def * v)
        int a = 0
        while (a < self.nnz) {
            r.set(self.rindices[a], self.cindices[a], self.values[a] * v)
            a = a + 1
        }
        return r
    }
    fn transpose() SparseMatrix {
        SparseMatrix t = SparseMatrix(self.cols, self.rows, self.def)
        int a = 0
        while (a < self.nnz) {
            t.set(self.cindices[a], self.rindices[a], self.values[a])
            a = a + 1
        }
        return t
    }
    fn multiply(SparseMatrix other) SparseMatrix {
        f64 da = self.def - 0.0
        f64 db = other.def - 0.0
        int dense_mode = 0
        if (da != 0.0) {
            dense_mode = 1
        }
        if (db != 0.0) {
            dense_mode = 1
        }
        if (dense_mode == 1) {
            Matrix a = self.to_dense()
            Matrix b = other.to_dense()
            Matrix c = a.mul(b)
            SparseMatrix r_dense = SparseMatrix(self.rows, other.cols, 0.0)
            int i = 0
            while (i < c.rows()) {
                int j = 0
                while (j < c.cols()) {
                    f64 v = eval(c.get(i, j))
                    f64 dz = v - 0.0
                    if (dz != 0.0) {
                        r_dense.set(i, j, v)
                    }
                    j = j + 1
                }
                i = i + 1
            }
            return r_dense
        }
        SparseMatrix r = SparseMatrix(self.rows, other.cols, 0.0)
        int a = 0
        while (a < self.nnz) {
            int i = self.rindices[a]
            int k = self.cindices[a]
            f64 av = self.values[a]
            int b = 0
            while (b < other.nnz) {
                if (other.rindices[b] == k) {
                    int j = other.cindices[b]
                    f64 cur = r.get(i, j)
                    r.set(i, j, cur + av * other.values[b])
                }
                b = b + 1
            }
            a = a + 1
        }
        return r
    }
    fn mv(Matrix v) Matrix {
        Matrix r = Matrix(self.rows, 1)
        f64 vsum = 0.0
        int j = 0
        while (j < self.cols) {
            f64 vj = eval(v.get(j, 0))
            vsum = vsum + vj
            j = j + 1
        }
        int i = 0
        while (i < self.rows) {
            f64 acc = 0.0
            int a = 0
            while (a < self.nnz) {
                if (self.rindices[a] == i) {
                    f64 vj = eval(v.get(self.cindices[a], 0))
                    f64 d = self.values[a] - self.def
                    acc = acc + d * vj
                }
                a = a + 1
            }
            f64 total = acc + self.def * vsum
            int iv = total * 1000.0
            r.set(i, 0, expr_rat(iv, 1000))
            i = i + 1
        }
        return r
    }
    fn print() {
        println("默认值: ")
        println(self.def)
        println("非默认元素数: ")
        println(self.nnz)
        int a = 0
        while (a < self.nnz) {
            println("(")
            println(self.rindices[a])
            println(", ")
            println(self.cindices[a])
            println(") = ")
            println(self.values[a])
            a = a + 1
        }
    }
    constructor(int r, int c, f64 d) {
        self.rows = r
        self.cols = c
        self.def = d
        self.nnz = 0
        self.cap = 0
    }
}

fn matrix_sparse(r: int, c: int) SparseMatrix {
    return SparseMatrix(r, c, 0.0)
}

fn matrix_sparse_identity(n: int) SparseMatrix {
    SparseMatrix m = SparseMatrix(n, n, 0.0)
    int i = 0
    while (i < n) {
        m.set(i, i, 1.0)
        i = i + 1
    }
    return m
}

fn matrix_sparse_from_dense(m: Matrix) SparseMatrix {
    SparseMatrix s = SparseMatrix(m.rows(), m.cols(), 0.0)
    int i = 0
    while (i < m.rows()) {
        int j = 0
        while (j < m.cols()) {
            f64 v = eval(m.get(i, j))
            f64 dz = v - 0.0
            if (dz != 0.0) {
                s.set(i, j, v)
            }
            j = j + 1
        }
        i = i + 1
    }
    return s
}

fn matrix_sparse_compress(m: Matrix) SparseMatrix {
    int r = m.rows()
    int c = m.cols()
    int n = r * c
    f64* vals = std.memory.kmm_v4_alloc(n * 8)
    int* cnts = std.memory.kmm_v4_alloc(n * 4)
    int nv = 0
    int i = 0
    while (i < r) {
        int j = 0
        while (j < c) {
            f64 v = eval(m.get(i, j))
            int k = 0
            int found = -1
            while (k < nv) {
                f64 d = vals[k] - v
                if (d == 0.0) {
                    found = k
                }
                k = k + 1
            }
            if (found >= 0) {
                cnts[found] = cnts[found] + 1
            } else {
                vals[nv] = v
                cnts[nv] = 1
                nv = nv + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    f64 defv = 0.0
    int found_def = -1
    int half = n / 2
    int k2 = 0
    while (k2 < nv) {
        if (cnts[k2] > half) {
            found_def = k2
        }
        k2 = k2 + 1
    }
    if (found_def >= 0) {
        defv = vals[found_def]
    }
    SparseMatrix s = SparseMatrix(r, c, defv)
    int i2 = 0
    while (i2 < r) {
        int j2 = 0
        while (j2 < c) {
            f64 v = eval(m.get(i2, j2))
            f64 d = v - defv
            if (d != 0.0) {
                s.set(i2, j2, v)
            }
            j2 = j2 + 1
        }
        i2 = i2 + 1
    }
    return s
}


class RationalMatrix {
    rows: int
    cols: int
    nums: BigInt*
    dens: BigInt*
    constructor(int r, int c) {
        self.rows = r
        self.cols = c
        int n = r * c
        self.nums = std.memory.std_malloc(n * sizeof(BigInt))
        self.dens = std.memory.std_malloc(n * sizeof(BigInt))
        int i = 0
        while (i < n) {
            self.nums[i] = std.algebra.bigint_from_i64(0)
            self.dens[i] = std.algebra.bigint_from_i64(1)
            i = i + 1
        }
    }
    fn set(int i, int j, Rational v) {
        int idx = i * self.cols + j
        self.nums[idx] = v.num
        self.dens[idx] = v.den
    }
    fn get(int i, int j) Rational {
        int idx = i * self.cols + j
        return Rational(self.nums[idx], self.dens[idx])
    }
    fn add(RationalMatrix other) RationalMatrix {
        RationalMatrix r = RationalMatrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Rational a = self.get(i, j)
                Rational b = other.get(i, j)
                r.set(i, j, a.add(b))
                j = j + 1
            }
            i = i + 1
        }
        return r
    }
    fn mul(RationalMatrix other) RationalMatrix {
        RationalMatrix r = RationalMatrix(self.rows, other.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < other.cols) {
                Rational acc = rat(0, 1)
                int k = 0
                while (k < self.cols) {
                    Rational a = self.get(i, k)
                    Rational b = other.get(k, j)
                    Rational p = a.mul(b)
                    acc = acc.add(p)
                    k = k + 1
                }
                r.set(i, j, acc)
                j = j + 1
            }
            i = i + 1
        }
        return r
    }
    fn print() {
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                Rational v = self.get(i, j)
                v.print()
                j = j + 1
            }
            i = i + 1
        }
    }
}

fn main() {
    println("=== Kaula Eigen 符号 demo(代数库 Expr, 不近似) ===")
    println("")
    println("A = [[1, 2], [3, 4]], B = [[5, 6], [7, 8]]")
    Matrix m = Matrix(2, 2)
    m.set(0, 0, expr_rat(1, 1))
    m.set(0, 1, expr_rat(2, 1))
    m.set(1, 0, expr_rat(3, 1))
    m.set(1, 1, expr_rat(4, 1))
    Expr e00 = m.get(0, 0)
    println("m(0,0) =")
    display(e00)
    println("")
    Matrix a = Matrix(2, 2)
    a.set(0, 0, expr_rat(1, 1))
    a.set(0, 1, expr_rat(2, 1))
    a.set(1, 0, expr_rat(3, 1))
    a.set(1, 1, expr_rat(4, 1))
    Matrix b = Matrix(2, 2)
    b.set(0, 0, expr_rat(5, 1))
    b.set(0, 1, expr_rat(6, 1))
    b.set(1, 0, expr_rat(7, 1))
    b.set(1, 1, expr_rat(8, 1))
    println("A + B =")
    Matrix s = a.add(b)
    s.print()
    println("")
    println("2 * A =")
    Matrix sa = a.scalar_mul(expr_rat(2, 1))
    sa.print()
    println("")
    println("A * B =")
    Matrix p = a.mul(b)
    p.print()
    println("")
    println("A^T =")
    Matrix t = a.transpose()
    t.print()
    println("")
    println("trace(A) =")
    Expr tr = a.trace()
    display(tr)
    println("")
    println("det(A) =")
    Expr d1 = a.determinant()
    display(d1)
    println("")
    println("det(diag(1,2,3,4)) = 24")
    Matrix dd = Matrix(4, 4)
    dd.set(0, 0, expr_rat(1, 1))
    dd.set(1, 1, expr_rat(2, 1))
    dd.set(2, 2, expr_rat(3, 1))
    dd.set(3, 3, expr_rat(4, 1))
    Expr d2 = dd.determinant()
    display(d2)
    println("")
    println("matrix_zeros(2,2) =")
    Matrix z = matrix_zeros(2, 2)
    z.print()
    println("")
    println("稀疏矩阵 × 向量(数值稀疏 → 符号结果):")
    SparseMatrix sp = matrix_sparse(3, 3)
    sp.set(0, 0, 1.5)
    sp.set(1, 0, -2.0)
    sp.set(2, 2, 5.0)
    Matrix vv = Matrix(3, 1)
    vv.set(0, 0, expr_rat(1, 1))
    vv.set(1, 0, expr_rat(2, 1))
    vv.set(2, 0, expr_rat(3, 1))
    Matrix sv = sp.mv(vv)
    sv.print()
    println("")
    println("稀疏单位阵(3x3):")
    SparseMatrix spi = matrix_sparse_identity(3)
    spi.print()
    println("")
    println("稀疏压缩(多数 7.0 → 自动默认值):")
    Matrix cp = Matrix(3, 3)
    cp.set(0, 0, expr_rat(7, 1))
    cp.set(0, 1, expr_rat(7, 1))
    cp.set(0, 2, expr_rat(7, 1))
    cp.set(1, 0, expr_rat(7, 1))
    cp.set(1, 1, expr_rat(7, 1))
    cp.set(1, 2, expr_rat(7, 1))
    cp.set(2, 0, expr_rat(7, 1))
    cp.set(2, 1, expr_rat(7, 1))
    cp.set(2, 2, expr_rat(9, 1))
    SparseMatrix spc = matrix_sparse_compress(cp)
    spc.print()
    println("")
    println("稀疏 from_dense:")
    SparseMatrix sfd = matrix_sparse_from_dense(cp)
    sfd.print()
    println("")
    println("matrix_identity(3) =")
    Matrix id3 = matrix_eye(3)
    id3.print()
    println("")
    println("matrix_ones(2,3) =")
    Matrix on23 = matrix_ones(2, 3)
    on23.print()
    println("")
    println("matrix_diag([1,2,3]) =")
    Matrix vd = Matrix(3, 1)
    vd.set(0, 0, expr_rat(1, 1))
    vd.set(1, 0, expr_rat(2, 1))
    vd.set(2, 0, expr_rat(3, 1))
    Matrix dgm = matrix_diag(vd)
    dgm.print()
    println("")
    println("A⁻¹ =")
    Matrix ai = a.inverse()
    ai.print()
    println("")
    println("A × A⁻¹ = I(符号验证):")
    Matrix chk = a.mul(ai)
    chk.print()
    println("")
    println("solve: 2x + y = 5, 3x + 4y = 11 → x=9/5, y=7/5")
    Matrix A = Matrix(2, 2)
    A.set(0, 0, expr_rat(2, 1))
    A.set(0, 1, expr_rat(1, 1))
    A.set(1, 0, expr_rat(3, 1))
    A.set(1, 1, expr_rat(4, 1))
    Matrix bb = Matrix(2, 1)
    bb.set(0, 0, expr_rat(5, 1))
    bb.set(1, 0, expr_rat(11, 1))
    Matrix x = A.solve(bb)
    x.print()
    println("")
    println("符号矩阵: S = [[1/2, √2], [π, 2/3]]")
    Matrix sm = Matrix(2, 2)
    sm.set(0, 0, expr_rat(1, 2))
    sm.set(0, 1, expr_pow(2, 1, 2))
    sm.set(1, 0, expr_pi())
    sm.set(1, 1, expr_rat(2, 3))
    println("S × S =")
    Matrix smul = sm.mul(sm)
    smul.print()
    println("")
    println("det(S) =")
    Expr d3 = sm.determinant()
    display(d3)
    println("")
    println("数值验证(仅当需要近似时 eval):")
    f64 v = eval(dd.determinant())
    println(v)
    println("")
    println("=== Rational 有理数 demo(代数库 rational.kl) ===")
    println("")
    println("1/2 + 1/3 =")
    Rational r1 = rat(1, 2)
    Rational r2 = rat(1, 3)
    Rational rsum = r1.add(r2)
    rsum.print()
    println("")
    println("1/2 * 2/3 =")
    Rational rp = r1.mul(rat(2, 3))
    rp.print()
    println("")
    println("1/2 / 1/3 =")
    Rational rq = r1.div(rat(1, 3))
    rq.print()
    println("")
    println("2/4 自动约分为 1/2:")
    Rational rr = rat(2, 4)
    rr.print()
    println("")
    println("分数矩阵 RM(2x2) * I =")
    RationalMatrix rma = RationalMatrix(2, 2)
    rma.set(0, 0, rat(1, 2))
    rma.set(0, 1, rat(1, 3))
    rma.set(1, 0, rat(2, 3))
    rma.set(1, 1, rat(1, 4))
    RationalMatrix rmb = RationalMatrix(2, 2)
    rmb.set(0, 0, rat(1, 1))
    rmb.set(0, 1, rat(0, 1))
    rmb.set(1, 0, rat(0, 1))
    rmb.set(1, 1, rat(1, 1))
    RationalMatrix rmm = rma.mul(rmb)
    rmm.print()
}
