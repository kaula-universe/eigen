import std.math
import std.memory

class Matrix {
    rows: int
    cols: int
    data: f64*
    fn rows() int {
        return self.rows
    }
    fn cols() int {
        return self.cols
    }
    fn set(int i, int j, f64 v) {
        self.data[i * self.cols + j] = v
    }
    fn get(int i, int j) f64 {
        return self.data[i * self.cols + j]
    }
    fn fill(f64 v) {
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            self.data[i] = v
            i = i + 1
        }
    }
    fn copy() Matrix {
        Matrix c = Matrix(self.rows, self.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                c.set(i, j, self.get(i, j))
                j = j + 1
            }
            i = i + 1
        }
        return c
    }
    fn add(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            r.data[i] = self.data[i] + other.data[i]
            i = i + 1
        }
        return r
    }
    fn sub(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            r.data[i] = self.data[i] - other.data[i]
            i = i + 1
        }
        return r
    }
    fn mul(Matrix other) Matrix {
        Matrix r = Matrix(self.rows, other.cols)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < other.cols) {
                f64 s = 0
                int k = 0
                while (k < self.cols) {
                    s = s + self.get(i, k) * other.get(k, j)
                    k = k + 1
                }
                r.set(i, j, s)
                j = j + 1
            }
            i = i + 1
        }
        return r
    }
    fn scalar_mul(f64 s) Matrix {
        Matrix r = Matrix(self.rows, self.cols)
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            r.data[i] = self.data[i] * s
            i = i + 1
        }
        return r
    }
    fn transpose() Matrix {
        Matrix t = Matrix(self.cols, self.rows)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                t.set(j, i, self.get(i, j))
                j = j + 1
            }
            i = i + 1
        }
        return t
    }
    fn trace() f64 {
        f64 s = 0
        int i = 0
        while (i < self.rows) {
            s = s + self.get(i, i)
            i = i + 1
        }
        return s
    }
    fn dot(Matrix other) f64 {
        f64 s = 0
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            s = s + self.data[i] * other.data[i]
            i = i + 1
        }
        return s
    }
    fn norm() f64 {
        f64 s = 0
        int n = self.rows * self.cols
        int i = 0
        while (i < n) {
            s = s + self.data[i] * self.data[i]
            i = i + 1
        }
        return std.math.math_sqrt(s)
    }
    fn determinant() f64 {
        Matrix w = self.copy()
        f64 det = 1
        int i = 0
        while (i < w.rows) {
            int piv = i
            int k = i + 1
            while (k < w.rows) {
                if (w.get(k, i) > w.get(piv, i)) {
                    piv = k
                }
                k = k + 1
            }
            if (w.get(piv, i) == 0) {
                return 0
            }
            if (piv != i) {
                w.swap_rows(piv, i)
                det = -det
            }
            f64 p = w.get(i, i)
            det = det * p
            int r = i + 1
            while (r < w.rows) {
                f64 f = w.get(r, i) / p
                int c = i
                while (c < w.cols) {
                    f64 nv = w.get(r, c) - f * w.get(i, c)
                    w.set(r, c, nv)
                    c = c + 1
                }
                r = r + 1
            }
            i = i + 1
        }
        return det
    }
    fn inverse() Matrix {
        Matrix inv = Matrix(self.rows, self.cols)
        Matrix w = self.copy()
        int i = 0
        while (i < w.rows) {
            inv.set(i, i, 1)
            i = i + 1
        }
        int col = 0
        while (col < w.rows) {
            int piv = col
            int k = col + 1
            while (k < w.rows) {
                if (w.get(k, col) > w.get(piv, col)) {
                    piv = k
                }
                k = k + 1
            }
            if (w.get(piv, col) == 0) {
                return Matrix(self.rows, self.cols)
            }
            if (piv != col) {
                w.swap_rows(piv, col)
                inv.swap_rows(piv, col)
            }
            f64 p = w.get(col, col)
            int c = 0
            while (c < w.cols) {
                f64 nv = w.get(col, c) / p
                w.set(col, c, nv)
                f64 iv = inv.get(col, c) / p
                inv.set(col, c, iv)
                c = c + 1
            }
            int r = 0
            while (r < w.rows) {
                if (r != col) {
                    f64 f = w.get(r, col)
                    int cc = 0
                    while (cc < w.cols) {
                        f64 nw = w.get(r, cc) - f * w.get(col, cc)
                        w.set(r, cc, nw)
                        f64 ni = inv.get(r, cc) - f * inv.get(col, cc)
                        inv.set(r, cc, ni)
                        cc = cc + 1
                    }
                }
                r = r + 1
            }
            col = col + 1
        }
        return inv
    }
    fn solve(Matrix b) Matrix {
        Matrix aug = Matrix(self.rows, self.cols + 1)
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                aug.set(i, j, self.get(i, j))
                j = j + 1
            }
            aug.set(i, self.cols, b.get(i, 0))
            i = i + 1
        }
        int col = 0
        while (col < self.rows) {
            int piv = col
            int k = col + 1
            while (k < self.rows) {
                if (aug.get(k, col) > aug.get(piv, col)) {
                    piv = k
                }
                k = k + 1
            }
            if (aug.get(piv, col) == 0) {
                return Matrix(0, 0)
            }
            if (piv != col) {
                aug.swap_rows(piv, col)
            }
            f64 p = aug.get(col, col)
            int r = col + 1
            while (r < self.rows) {
                f64 f = aug.get(r, col) / p
                int c = col
                while (c < aug.cols) {
                    f64 nv = aug.get(r, c) - f * aug.get(col, c)
                    aug.set(r, c, nv)
                    c = c + 1
                }
                r = r + 1
            }
            col = col + 1
        }
        Matrix x = Matrix(self.rows, 1)
        int row = self.rows - 1
        while (row >= 0) {
            f64 s = aug.get(row, self.cols)
            int j = row + 1
            while (j < self.cols) {
                s = s - aug.get(row, j) * x.get(j, 0)
                j = j + 1
            }
            x.set(row, 0, s / aug.get(row, row))
            row = row - 1
        }
        return x
    }
    fn swap_rows(int a, int b) {
        int j = 0
        while (j < self.cols) {
            f64 t = self.get(a, j)
            self.set(a, j, self.get(b, j))
            self.set(b, j, t)
            j = j + 1
        }
    }
    fn print() {
        int i = 0
        while (i < self.rows) {
            int j = 0
            while (j < self.cols) {
                f64 v = self.get(i, j)
                println(v)
                j = j + 1
            }
            i = i + 1
        }
    }
    constructor(int r, int c) {
        self.rows = r
        self.cols = c
        self.data = std.memory.kmm_v4_alloc(r * c * 8)
    }
}

fn matrix_zeros(r: int, c: int) Matrix {
    return Matrix(r, c)
}

fn matrix_ones(r: int, c: int) Matrix {
    Matrix m = Matrix(r, c)
    int n = r * c
    int i = 0
    while (i < n) {
        m.data[i] = 1
        i = i + 1
    }
    return m
}

fn matrix_identity(n: int) Matrix {
    Matrix m = Matrix(n, n)
    int i = 0
    while (i < n) {
        m.set(i, i, 1)
        i = i + 1
    }
    return m
}

fn matrix_random(r: int, c: int) Matrix {
    Matrix m = Matrix(r, c)
    int seed = 42
    int i = 0
    while (i < r) {
        int j = 0
        while (j < c) {
            seed = (seed * 1103515245 + 12345) % 2147483648
            f64 v = seed % 1000 / 1000.0
            m.set(i, j, v)
            j = j + 1
        }
        i = i + 1
    }
    return m
}

fn main() {
    println("=== Kaula Eigen demo ===")
    println("")
    Matrix m = Matrix(2, 2)
    m.set(0, 0, 1)
    m.set(0, 1, 2)
    m.set(1, 0, 3)
    m.set(1, 1, 4)
    f64 e00 = m.get(0, 0)
    println("m(0,0) = ")
    println(e00)
    println("")
    Matrix a = Matrix(2, 2)
    a.set(0, 0, 1)
    a.set(0, 1, 2)
    a.set(1, 0, 3)
    a.set(1, 1, 4)
    Matrix b = Matrix(2, 2)
    b.set(0, 0, 5)
    b.set(0, 1, 6)
    b.set(1, 0, 7)
    b.set(1, 1, 8)
    println("A + B =")
    Matrix s = a.add(b)
    s.print()
    println("")
    println("A - B =")
    Matrix d = a.sub(b)
    d.print()
    println("")
    println("2 * A =")
    Matrix sa = a.scalar_mul(2)
    sa.print()
    println("")
    println("A * B =")
    Matrix p = a.mul(b)
    p.print()
    println("")
    println("A^T =")
    Matrix t = a.transpose()
    t.print()
    println("")
    f64 tr = a.trace()
    println("trace(A) = ")
    println(tr)
    println("")
    f64 det = a.determinant()
    println("det(A) = ")
    println(det)
    println("")
    println("A^-1 =")
    Matrix inv = a.inverse()
    inv.print()
    println("")
    println("A * A^-1 =")
    Matrix chk = a.mul(inv)
    chk.print()
    println("")
    Matrix c3 = Matrix(3, 3)
    c3.set(0, 0, 1)
    c3.set(0, 1, 2)
    c3.set(0, 2, 3)
    c3.set(1, 0, 0)
    c3.set(1, 1, 1)
    c3.set(1, 2, 4)
    c3.set(2, 0, 5)
    c3.set(2, 1, 6)
    c3.set(2, 2, 0)
    f64 det3 = c3.determinant()
    println("det(3x3) = ")
    println(det3)
    println("")
    println("solve: 2x + y = 3, x + 3y = 5")
    Matrix A = Matrix(2, 2)
    A.set(0, 0, 2)
    A.set(0, 1, 1)
    A.set(1, 0, 1)
    A.set(1, 1, 3)
    Matrix bb = Matrix(2, 1)
    bb.set(0, 0, 3)
    bb.set(1, 0, 5)
    Matrix x = A.solve(bb)
    f64 x0 = x.get(0, 0)
    f64 x1 = x.get(1, 0)
    println("x = ")
    println(x0)
    println("y = ")
    println(x1)
    println("")
    println("向量 v = [3, 4], |v| = ")
    Matrix v = Matrix(2, 1)
    v.set(0, 0, 3)
    v.set(1, 0, 4)
    f64 nv = v.norm()
    println(nv)
    println("")
    println("Identity(3) =")
    Matrix id3 = matrix_identity(3)
    id3.print()
    println("")
    println("Random(2, 2) =")
    Matrix rnd = matrix_random(2, 2)
    rnd.print()
}
